{
  "name": "boris-martinez-tattoo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter @boris-martinez-tattoo/web dev",
    "dev:api": "pnpm --filter @boris-martinez-tattoo/api dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @boris-martinez-tattoo/web preview",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm -r --if-present check",
    "db:generate": "pnpm --filter @boris-martinez-tattoo/database db:generate"
  }
}