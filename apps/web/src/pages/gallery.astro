---
import BaseLayout from '@layouts/BaseLayout.astro';
// import ImagePlaceholder from '@components/ImagePlaceholder.astro';
import AssayMark from '@components/AssayMark.astro';
import CtaButton from '@components/CtaButton.astro';
import { BASE_URL } from '@config/site';
import { PORTFOLIO_CATALOG, getMediaUrl } from '@domain/portfolio';
import Image from '@components/Image.astro';

/* The full register: grid of registered pieces. Serials, placements
   and sessions are illustrative until real pieces are supplied. */
// const aspects = [
//   'aspect-[3/4]',
//   'aspect-square',
//   'aspect-[4/5]',
//   'aspect-[3/5]',
//   'aspect-[4/3]',
//   'aspect-[2/3]',
// ];

// const placements = ['Forearm', 'Shoulder', 'Back', 'Calf', 'Sternum', 'Upper arm'];

// const entries = Array.from({ length: 18 }, (_, i) => ({
//   serial: `No. ${String(42 - i).padStart(3, '0')}`,
//   placement: placements[i % placements.length],
//   session: i < 8 ? '2026' : '2025',
//   aspect: aspects[i % aspects.length],
// }));
---

<BaseLayout title="The Portfolio — Boris Martínez Tattoo" description="The full portfolio — every piece struck by Boris Martínez Tattoo, each entered with its assay mark.">
  <main class="shell py-16 md:py-18">
    <div class="reveal flex flex-wrap items-end justify-between gap-6 border-b border-border pb-8">
      <div>
        <p class="font-mono text-2xs uppercase tracking-[0.2em] text-tertiary-400">Entry — The Work</p>
        <h1 class="mt-3 font-secondary text-4xl tracking-[0.02em] text-foreground md:text-5xl">The Portfolio</h1>
        <p class="mt-4 max-w-xl text-muted-foreground">
          Every piece struck, newest first — each entered with its assay mark:
          serial, placement, and session.
        </p>
      </div>
      <CtaButton href={`${BASE_URL}/`} variant="outline" title="Back to the home page — Boris Martínez Tattoo" class="px-5 py-2.5 text-xs">
        &larr; Back to the front
      </CtaButton>
    </div>

    {/* grid: row-major order matches PORTFOLIO_CATALOG sequence */}
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
      {PORTFOLIO_CATALOG.map((entry, i) => {
        const imageUrl = getMediaUrl(entry.fileName, entry.type);
        return (
          <figure class="reveal flex w-full" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
            <div class="flex w-full flex-col overflow-hidden border border-border bg-raised transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-2xl">
              <a 
                href={imageUrl}
                class="glightbox block aspect-4/5 cursor-pointer overflow-hidden group"
                data-gallery="register-gallery"
              >
                <Image 
                  src={imageUrl} 
                  alt={entry.title} 
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </a>
              <figcaption class="mt-auto border-t border-border bg-raised px-4 py-3">
                <AssayMark serial={entry.id} placement={entry.placement} category={entry.category} />
              </figcaption>
            </div>
          </figure>
        );
      })}
    </div>

    <div class="reveal mt-14 border-t border-border pt-10 text-center">
      <CtaButton href={`${BASE_URL}/#booking`} title="Request a custom tattoo commission" class="px-8 py-3.5 text-sm">
        Request your own entry
      </CtaButton>
    </div>
  </main>
</BaseLayout>

<script>
  import GLightbox from 'glightbox';

  /* The lightbox skin is only needed once a piece is opened — load it
     as its own chunk so it stays off the render-blocking CSS path. */
  void import('glightbox/dist/css/glightbox.min.css');

  GLightbox({
    selector: '.glightbox',
    touchNavigation: true,
    loop: true,
    zoomable: true,
    openEffect: 'fade',
    closeEffect: 'fade',
  });
</script>