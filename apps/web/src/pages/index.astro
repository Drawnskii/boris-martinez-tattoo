---
/* -----------------------------------------------------------------
   DIRECTION CONTRACT — The Assay Catalog (seed 2c2399eb, user-chosen)

   THESIS: Every tattoo leaves this studio hallmarked like silver —
   entered in a register with its assay stamp. The home page is that
   register, refusing the category's dark photo-grid + gothic type.
   OWN-WORLD: matte graphite velvet ground, engraved Cinzel
   inscriptions, Archivo register hand, JetBrains Mono assay marks,
   beige only where a document or seal exists. Sharp corners,
   hairline rules, no card shadows.
   STORY: visitor meets the master mark (living mercury), reads the
   house standard, walks the register, learns care of the metal, and
   requests a commission.
   FIRST VIEWPORT: full velvet field; centered liquid-mercury drop
   (WebGL); engraved wordmark above; stamped commission seal below.
   FORM: silversmith assay catalog, candidate 3 by resonance, staging
   is the editorial ledger scroll (split-corridor staging rejected:
   it fragments a premium linear reading); seed key 2c2399eb.
   ----------------------------------------------------------------- */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import About from '@components/sections/About.astro';
import Portfolio from '@components/sections/Portfolio.astro';
import Pricing from '@components/sections/Pricing.astro';
import Health from '@components/sections/Health.astro';
import Location from '@components/sections/Location.astro';
import Booking from '@components/sections/Booking.astro';
---

<BaseLayout>
  <main>
    <Hero />
    <Portfolio />
    <About />
    <Pricing />
    <Health />
    <Location />
    <Booking />
  </main>
</BaseLayout>
