---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@config/site';
---

<BaseLayout>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-secondary text-5xl text-foreground">{SITE.name}</h1>
    <p class="mt-4 max-w-prose text-lg text-muted-foreground">{SITE.description}</p>

    <section class="mt-12">
      <h2 class="font-secondary text-2xl">Design system preview</h2>

      <p class="mt-2 text-sm text-muted-foreground">
        Live tokens from <code class="rounded-sm bg-muted px-1">src/styles/global.css</code> —
        rebrand by editing the OKLCH scales.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg bg-primary-500 p-4 text-white">Primary 500</div>
        <div class="rounded-lg bg-secondary-500 p-4 text-white">Secondary 500</div>
        <div class="rounded-lg bg-tertiary-500 p-4 text-surface-950">Tertiary 500</div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2 text-2xs">
        <span class="rounded-md bg-primary-100 px-2 py-1 text-primary-900">primary-100</span>
        <span class="rounded-md bg-primary-300 px-2 py-1 text-primary-900">primary-300</span>
        <span class="rounded-md bg-primary-500 px-2 py-1 text-white">primary-500</span>
        <span class="rounded-md bg-primary-700 px-2 py-1 text-white">primary-700</span>
        <span class="rounded-md bg-primary-900 px-2 py-1 text-white">primary-900</span>
      </div>

      <div class="mt-8 space-y-1">
        <p class="text-2xs">text-2xs · The quick ink flows</p>
        <p class="text-xs">text-xs · The quick ink flows</p>
        <p class="text-sm">text-sm · The quick ink flows</p>
        <p class="text-base">text-base · The quick ink flows</p>
        <p class="text-lg">text-lg · The quick ink flows</p>
        <p class="text-xl">text-xl · The quick ink flows</p>
        <p class="text-2xl">text-2xl · The quick ink flows</p>
        <p class="text-3xl">text-3xl · The quick ink flows</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <span class="rounded-none border border-border px-3 py-2">rounded-none</span>
        <span class="rounded-sm border border-border px-3 py-2">rounded-sm</span>
        <span class="rounded-md border border-border px-3 py-2">rounded-md</span>
        <span class="rounded-lg border border-border px-3 py-2">rounded-lg</span>
        <span class="rounded-xl border border-border px-3 py-2">rounded-xl</span>
        <span class="rounded-2xl border border-border px-3 py-2">rounded-2xl</span>
        <span class="rounded-3xl border border-border px-3 py-2">rounded-3xl</span>
        <span class="rounded-full border border-border px-3 py-2">rounded-full</span>
      </div>

      <p class="mt-8 font-secondary text-2xl">Secondary font — display heading</p>
      <p class="font-primary text-base">Primary font — body / UI text</p>
    </section>
  </main>
</BaseLayout>