---
import '@styles/global.css';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { SITE, NAV_LAYOUT, NAV_CONTENT_OFFSET, BASE_URL } from '@config/site';
import Navbar from '@components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

// Sidebar nav is fixed and w-56 — offset page content on lg+ screens.
const contentOffset = NAV_CONTENT_OFFSET[NAV_LAYOUT];
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    <link rel="icon" type="image/png" href=`${BASE_URL}/favicon-96x96.png` sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href=`${BASE_URL}/favicon.svg` />
    <link rel="shortcut icon" href=`${BASE_URL}/favicon.ico` />
    <link rel="apple-touch-icon" sizes="180x180" href=`${BASE_URL}/apple-touch-icon.png` />
    <meta name="apple-mobile-web-app-title" content=`Boris Martínez` />
    <link rel="manifest" href=`${BASE_URL}/site.webmanifest` />
    
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content=`${BASE_URL}/og-image.png` />
    <meta property="og:site_name" content="Boris Martinez Tattoo Artist" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content=`${BASE_URL}/og-image.png` />
    
    {/* Flag <html> as JS-capable BEFORE the body paints, so the reveal
        stylesheet knows it can hide .reveal elements safely. Without
        this class the reveal CSS never hides anything — content stays
        visible if JS fails to run. Inline so it executes in the head
        ahead of first paint. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen bg-background font-primary text-foreground">
    <Navbar />
    <div class={contentOffset}>
      <slot />
    </div>
    {/* Reveal observer — adds .is-visible to .reveal elements as they
        walk into view. Progressive enhancement: pre-marks anything
        already on-screen at DOMContentLoaded so above-the-fold content
        never flashes hidden-then-shown; falls back to instant-reveal
        if IntersectionObserver is missing. */}
    <script>
      const setupReveal = () => {
        const els = Array.from(document.querySelectorAll('.reveal'));
        if (els.length === 0) return;
        const viewportH = window.innerHeight;
        els.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < viewportH && r.bottom > 0) el.classList.add('is-visible');
        });
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => {
          if (!el.classList.contains('is-visible')) obs.observe(el);
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }
    </script>
  </body>
</html>
