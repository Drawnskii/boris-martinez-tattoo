---
import SectionHeading from '@components/SectionHeading.astro';
import BirthDateField from '@components/forms/BirthDateField.astro';
import PhoneInput from '@components/forms/PhoneInput.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const inputClass =
  'w-full border border-border bg-raised px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-tertiary-400 focus:outline-none';

const labelClass = 'mb-1.5 block font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground';
const errorClass = 'mt-1.5 font-mono text-2xs uppercase tracking-[0.12em] text-foreground';
---

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('booking');
    if (!section) return;
    const load = () => {
      const s = document.createElement('script');
      s.src = 'https://js.hcaptcha.com/1/api.js';
      s.async = true;
      document.head.appendChild(s);
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0]?.isIntersecting) {
            load();
            observer.disconnect();
          }
        },
        { rootMargin: '400px 0px 0px 0px' },
      );
      observer.observe(section);
    } else {
      load();
    }
  });
</script>

<section id="booking" class="flex min-h-svh flex-col justify-center border-t border-border bg-raised/50 py-16 md:py-18">
  <div class="shell" style="--shell-max: 48rem">
    <div class="reveal">
      <SectionHeading
        tag="Entry VI — The Request"
        title="Book a Consultation"
        subtitle="Describe the piece you want struck. The studio replies within 24–48 hours to confirm the consultation and the deposit."
      />
    </div>

    {/* the commission slip — every field is a ruled line */}
    <form
      id="booking-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      novalidate
      class="reveal relative mt-14 border border-border bg-background p-6 md:p-10"
    >
      <input type="hidden" name="access_key" value={accessKey} />

      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div data-refusal hidden class="pointer-events-none absolute inset-0 z-20 items-center justify-center" aria-hidden="true">
        <p class="-rotate-3 border-y border-foreground/40 bg-background/70 px-5 py-3 text-center font-mono text-xs uppercase tracking-[0.28em] text-foreground/80">
          Not of age — the studio books 18+
        </p>
      </div>

      <div class="flex items-center justify-between border-b border-border pb-4">
        <p class="font-mono text-2xs uppercase tracking-[0.2em] text-tertiary-400">
          Commission slip
        </p>
        <p class="font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground">
          Boris Martínez Tattoo
        </p>
      </div>

      <div class="mt-8 grid gap-x-6 gap-y-7 sm:grid-cols-2">
        <div data-field="name" data-state="pending">
          <label for="booking-name" class={labelClass}>Name</label>
          <input
            id="booking-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your name"
            class={inputClass}
            aria-describedby="booking-name-error"
          />
          <p id="booking-name-error" data-field-error hidden class={errorClass}></p>
        </div>

        <div data-field="email" data-state="pending">
          <label for="booking-email" class={labelClass}>Email</label>
          <input
            id="booking-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class={inputClass}
            aria-describedby="booking-email-error"
          />
          <p id="booking-email-error" data-field-error hidden class={errorClass}></p>
        </div>

        <div data-field="phone" data-state="pending">
          <label for="booking-phone" class={labelClass}>Phone</label>
          <PhoneInput class={inputClass} />
          <p id="booking-phone-error" data-field-error hidden class={errorClass}></p>
        </div>

        <div data-field="birthdate" data-state="pending">
          <label for="booking-birthdate" class={labelClass}>Date of birth</label>
          <BirthDateField inputClass={inputClass} />
        </div>

        <div class="sm:col-span-2" data-field="idea" data-state="pending">
          <label for="booking-idea" class={labelClass}>The design</label>
          <textarea
            id="booking-idea"
            name="idea"
            rows="4"
            required
            placeholder="Describe the design, placement, references..."
            class={inputClass}
            aria-describedby="booking-idea-error"
          ></textarea>
          <p id="booking-idea-error" data-field-error hidden class={errorClass}></p>
        </div>
      </div>

      <div class="mt-8 flex flex-col items-start justify-between gap-4 border-t border-border pt-6 sm:flex-row sm:items-center">
        <div
          id="captcha"
          class="h-captcha"
          data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2"
          data-theme="dark"
          data-callback="onCaptchaSuccess"
          data-expired-callback="onCaptchaExpired"
        ></div>
        <p id="captcha-error" class="mt-2 hidden font-mono text-2xs uppercase tracking-[0.12em] text-foreground">Complete the captcha to stamp the request</p>

        <button
          id="submit-btn"
          type="submit"
          class="hidden cursor-pointer bg-paper px-8 py-3.5 font-secondary text-sm font-semibold uppercase tracking-[0.12em] text-paper-foreground transition-all hover:bg-tertiary-300 hover:shadow-[0_2px_8px_rgba(0,0,0,0.4)] active:translate-y-px active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-50"
        >
          Stamp the request
        </button>
        <p id="booking-confirmation" class="hidden font-mono text-xs tracking-[0.06em] text-tertiary-300" role="status">
          Request stamped — the studio will reply within 24–48 h.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  [data-refusal]:not([hidden]) {
    display: flex;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-refusal]:not([hidden]) p {
      animation: refusal-press 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes refusal-press {
    from {
      opacity: 0;
      transform: rotate(-3deg) scale(1.08);
    }
    to {
      opacity: 1;
      transform: rotate(-3deg) scale(1);
    }
  }
</style>

<script>
  declare global {
    interface Window {
      onCaptchaSuccess: () => void;
      onCaptchaExpired: () => void;
      hcaptcha?: {
        reset: () => void;
      };
    }
  }

  interface BirthdateDetail {
    value: string;
    ok: boolean;
    reason: string | null;
    age: number | null;
    touched: boolean;
  }

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const confirmation = document.getElementById('booking-confirmation');
  const captchaError = document.getElementById('captcha-error');
  const captcha = document.getElementById('captcha');
  const submit = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const refusal = document.querySelector<HTMLElement>('[data-refusal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fieldRows = Array.from(document.querySelectorAll<HTMLElement>('[data-field]'));
  const touchedFields = new Set<string>();

  let refused = false;
  let birthdateOk = false;

  const rowFor = (key: string) => fieldRows.find((row) => row.dataset.field === key) ?? null;

  const controlFor = (key: string) =>
    rowFor(key)?.querySelector<HTMLInputElement | HTMLTextAreaElement>('input:not([type="hidden"]), textarea') ?? null;

  const digitsIn = (row: HTMLElement) =>
    Array.from(row.querySelectorAll<HTMLInputElement>('input')).reduce(
      (longest, el) => Math.max(longest, el.value.replace(/\D/g, '').length),
      0,
    );

  const checks: Record<string, () => boolean> = {
    name: () => (controlFor('name')?.value.trim().length ?? 0) >= 2,
    email: () => {
      const el = controlFor('email');
      return !!el && el.value.trim() !== '' && el.validity.valid;
    },
    phone: () => {
      const row = rowFor('phone');
      return !!row && digitsIn(row) >= 7;
    },
    idea: () => (controlFor('idea')?.value.trim().length ?? 0) >= 10,
  };

  const messages: Record<string, string> = {
    name: 'Enter your name',
    email: 'Enter a valid email — the studio replies there',
    phone: 'Enter a reachable phone number',
    idea: 'Describe the design, placement, and size — a sentence is enough',
  };

  const updateField = (key: string) => {
    const row = rowFor(key);
    if (!row) return;
    const valid = checks[key]?.() ?? true;
    const touched = touchedFields.has(key);
    row.dataset.state = valid ? 'valid' : touched ? 'invalid' : 'pending';

    const error = row.querySelector<HTMLElement>('[data-field-error]');
    if (error) {
      error.textContent = valid || !touched ? '' : (messages[key] ?? '');
      error.hidden = valid || !touched;
    }

    const control = controlFor(key);
    if (control) control.setAttribute('aria-invalid', String(!valid && touched));
  };

  (['name', 'email', 'phone', 'idea'] as const).forEach((key) => {
    const row = rowFor(key);
    if (!row) return;
    row.addEventListener('input', () => updateField(key));
    row.addEventListener('focusout', (event) => {
      if (!row.contains(event.relatedTarget as Node | null)) {
        touchedFields.add(key);
        updateField(key);
      }
    });
  });

  const syncSubmit = () => {
    if (submit) submit.disabled = refused;
  };

  document.addEventListener('birthdate:change', (event) => {
    const detail = (event as CustomEvent<BirthdateDetail>).detail;
    const row = rowFor('birthdate');
    if (row) {
      const definitive = detail.reason !== null && detail.reason !== 'invalid';
      const showInvalid = !detail.ok && detail.reason !== null && (detail.touched || definitive);
      row.dataset.state = detail.ok ? 'valid' : showInvalid ? 'invalid' : 'pending';
    }

    birthdateOk = detail.ok;
    refused = detail.reason === 'minor';

    if (refusal) refusal.hidden = !refused;
    syncSubmit();
  });

  const validateAll = () => {
    (['name', 'email', 'phone', 'idea'] as const).forEach((key) => {
      touchedFields.add(key);
      updateField(key);
    });

    document.dispatchEvent(new CustomEvent('booking:validate'));

    const allValid = birthdateOk && (['name', 'email', 'phone', 'idea'] as const).every((key) => checks[key]?.() ?? true);
    if (!allValid) {
      form?.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    }
    return allValid && !refused;
  };

  window.onCaptchaSuccess = () => {
    if (!captcha || !submit) return;

    captchaError?.classList.add('hidden');

    if (reduceMotion) {
      captcha.classList.add('hidden');
      submit.classList.remove('hidden');
      syncSubmit();
    } else {
      const hideAnim = captcha.animate(
        [
          { opacity: 1, height: captcha.scrollHeight + 'px', margin: '1.5rem 0 0 0' },
          { opacity: 0, height: '0px', margin: '0' },
        ],
        { duration: 400, easing: 'ease-in-out', fill: 'forwards' },
      );

      hideAnim.onfinish = () => {
        captcha.classList.add('hidden');
        submit.classList.remove('hidden');
        syncSubmit();

        submit.animate(
          [
            { opacity: 0, transform: 'translateY(10px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 400, easing: 'ease-out', fill: 'both' },
        );
      };
    }
  };

  window.onCaptchaExpired = () => {
    captcha?.getAnimations().forEach((anim) => anim.cancel());
    submit?.getAnimations().forEach((anim) => anim.cancel());

    submit?.classList.add('hidden');
    captcha?.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const botcheck = form.querySelector('input[name="botcheck"]') as HTMLInputElement;
    if (botcheck && botcheck.checked) {
      form.reset();
      return;
    }

    confirmation?.classList.add('hidden');
    captchaError?.classList.add('hidden');

    if (!validateAll()) return;

    const tempFormData = new FormData(form as HTMLFormElement);
    const hCaptchaResponse = tempFormData.get('h-captcha-response');
    if (!hCaptchaResponse) {
      captchaError?.classList.remove('hidden');
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalBtnText = submitBtn.innerText;

    if (submitBtn) {
      submitBtn.innerText = 'Stamping...';
      submitBtn.disabled = true;
    }

    try {
      const finalFormData = new FormData(form as HTMLFormElement);

      finalFormData.delete('g-recaptcha-response');

      const urlRegex = /(https?:\/\/[^\s]+)|(www\.[^\s]+)/gi;

      for (const [key, value] of finalFormData.entries()) {
        if (typeof value === 'string') {
          let sanitizedValue = value.replace(/</g, '&lt;').replace(/>/g, '&gt;');
          sanitizedValue = sanitizedValue.replace(urlRegex, '[ENLACE REMOVIDO]');

          finalFormData.set(key, sanitizedValue);
        }
      }

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
        },
        body: finalFormData,
      });

      if (response.ok) {
        form.reset();
        birthdateOk = false;
        refused = false;
        if (refusal) refusal.hidden = true;
        fieldRows.forEach((row) => {
          row.dataset.state = 'pending';
          const error = row.querySelector<HTMLElement>('[data-field-error]');
          if (error) {
            error.textContent = '';
            error.hidden = true;
          }
        });

        captcha?.getAnimations().forEach((anim) => anim.cancel());
        submit?.getAnimations().forEach((anim) => anim.cancel());

        submit?.classList.add('hidden');
        captcha?.classList.remove('hidden');

        if (typeof window !== 'undefined' && window.hcaptcha) {
          window.hcaptcha.reset();
        }

        confirmation?.classList.remove('hidden');
        if (!reduceMotion) {
          confirmation?.animate(
            [
              { opacity: 0, transform: 'translateY(0.5rem)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 300, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' },
          );
        }
      } else {
        alert('There was an issue stamping your request. Please try again.');
      }
    } catch {
      alert('Connection error. Please check your network and try again.');
    } finally {
      if (submitBtn) {
        submitBtn.innerText = originalBtnText;
        submitBtn.disabled = false;
        syncSubmit();
      }
    }
  });
</script>
