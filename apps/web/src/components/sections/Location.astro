---
import { Icon } from 'astro-icon/components';

import SectionHeading from '@components/SectionHeading.astro';
import LocationMap from '@components/LocationMap.astro';
---

<section id="location" class="flex min-h-svh flex-col justify-center py-16 md:py-18">
  <div class="shell">
    <div class="reveal">
      <SectionHeading
        tag="Entry V — The Location"
        title="Find the location"
        subtitle="By appointment only — book an appointment first, then call for the consultation."
      />
    </div>

    {/* the survey: map plate with the atelier ledger docked to its lower-left */}
    <div class="reveal relative mt-14" style="--reveal-delay: 80ms" data-assay-survey>
      <LocationMap />

      <div class="mt-6 border border-border bg-background lg:absolute lg:bottom-6 lg:left-6 lg:mt-0 lg:w-96 lg:bg-background/90 lg:backdrop-blur" data-assay-ledger>
        <div class="flex items-baseline gap-4 border-b border-border px-4 py-3.5" data-map-cue>
          <span class="w-20 shrink-0 font-mono text-2xs uppercase tracking-[0.14em] text-tertiary-400">Address</span>
          <address class="text-sm not-italic leading-relaxed text-muted-foreground">
            258 Elizabeth St<br />
            New York, NY 10012<br />
            USA
          </address>
        </div>

        <div class="flex items-baseline gap-4 border-b border-border px-4 py-3.5" data-map-cue>
          <span class="w-20 shrink-0 font-mono text-2xs uppercase tracking-[0.14em] text-tertiary-400">Contact</span>
          <p class="text-sm leading-relaxed text-muted-foreground">
            <a href="tel:+18183516420" class="transition-colors hover:text-tertiary-300">+1 (818) 351-6420</a><br />
            <a href="mailto:Martínezzboris@gmail.com" class="transition-colors hover:text-tertiary-300">Martínezzboris@gmail.com</a>
          </p>
        </div>

        <a
          href="https://ig.me/m/borismartinez__/"
          title="Message the studio on Instagram to request an appointment"
          class="flex items-center justify-between gap-2 bg-paper px-4 py-4 font-secondary text-xs font-semibold uppercase tracking-[0.12em] text-paper-foreground transition-colors hover:bg-tertiary-300"
          target="_blank"
          rel="noopener noreferrer"
        >
          DM for appointments
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* The ledger and the map are one instrument: pointing at a row pulses the
     studio marker like a survey plate. */

  const cueRows = document.querySelectorAll<HTMLElement>('[data-map-cue]');

  const cue = (on: boolean) => {
    document.querySelectorAll('.assay-marker-dot').forEach((dot) => dot.classList.toggle('is-pulsing', on));
  };

  cueRows.forEach((row) => {
    row.addEventListener('mouseenter', () => cue(true));
    row.addEventListener('mouseleave', () => cue(false));
    row.addEventListener('focusin', () => cue(true));
    row.addEventListener('focusout', () => cue(false));
  });
</script>
