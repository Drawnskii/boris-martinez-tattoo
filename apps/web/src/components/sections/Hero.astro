---
import TemplateShader from "@components/shaders/template-shader/TemplateShader.astro"
import CtaButton from "@components/CtaButton.astro"
import { BASE_URL } from "@config/site"
---

<section id="hero" class="relative min-h-svh w-full overflow-hidden">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <TemplateShader />
  </div>

  {/* safety veil: the night never competes with the register on narrow screens */}
  <div class="pointer-events-none absolute inset-0 z-10 bg-background/30 lg:bg-transparent" aria-hidden="true"></div>

    {/* gradient veil: denser under the inscription, clearing toward the night */}
  <div class="pointer-events-none absolute inset-0 z-10 bg-linear-to-r from-background via-background/45 to-transparent lg:via-background/20" aria-hidden="true"></div>

  {/* bottom fade: the night dissolves into the page ground instead of a
      hard crop at the hero's edge when scrolling into the next entry */}
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40 bg-linear-to-t from-background via-background/70 to-transparent lg:h-56" aria-hidden="true"></div>

  {/* text column rides the same .shell edges as every other section */}
  <div class="shell relative z-20 flex min-h-svh flex-col justify-between pb-12 pt-24 lg:pb-14 lg:pt-28">
    {/* meta: the role, and the footprint entered as register data */}
    <div class="hero-strike-1 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-end">
      <div class="sm:text-right">
        <p class="font-mono text-2xs uppercase tracking-[0.2em] text-muted-foreground">Working footprint</p>
        <p class="mt-2 font-mono text-sm uppercase tracking-[0.16em] text-foreground">Los Angeles · New Jersey · New York</p>
      </div>
    </div>

    {/* the inscription */}
    <div class="py-14 lg:py-16">
      <h1 class="hero-stamp font-secondary text-[clamp(2.25rem,10.5vw,6rem)] font-bold uppercase leading-[0.95] tracking-[0.04em] text-foreground">
        <p class="font-mono text-2xs font-normal uppercase tracking-[0.2em] text-muted-foreground mb-4 translate-x-2">Tattoo Artist</p>
        <span class="block">Boris</span>
        <span class="block">Martínez</span>
        <span class="sr-only"> — Tattoo Artist</span>
      </h1>

      <div class="mt-5 flex flex-col gap-8 lg:mt-6">
        <p class="hero-strike-2 max-w-md text-base text-muted-foreground">
          Holding every piece to the highest standard, bringing singular designs onto living canvas.
        </p>

        <div class="hero-strike-3 flex flex-row items-center gap-3">
          <CtaButton href="#booking" title="Book your tattoo session" class="px-8 py-3.5 text-sm">
            Book Your Session
          </CtaButton>
          <CtaButton href={`${BASE_URL}/gallery`} variant="outline" title="See Boris Martínez's tattoo work" class="px-8 py-3.5 text-sm">
            View Portfolio
          </CtaButton>
        </div>
      </div>
    </div>

    {/* the hero's foot: policy left, the way down right */}
    <div class="hero-strike-4 flex items-center font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground">
      <span>By appointment only</span>
    </div>
  </div>
</section>

<style>
  /* -----------------------------------------------------------------
     The silversmith's strike — one rehearsed hero entrance.

     The engraved name presses down via clip-path; the role, tagline,
     CTAs and foot strike in sequence. Exponential ease-out, ~1.2s
     total, one-shot.

     Progressive enhancement: content is visible by default. The
     `from` state applies only while the animation is scheduled
     (fill-mode: both). Under prefers-reduced-motion: reduce the
     animations are not declared, so the element stays visible.
     ----------------------------------------------------------------- */
  @keyframes hero-stamp-down {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-strike-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-stamp {
      animation: hero-stamp-down 750ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 60ms;
      will-change: opacity, clip-path;
    }
    .hero-strike-1 {
      animation: hero-strike-in 400ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-strike-2 {
      animation: hero-strike-in 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 700ms;
    }
    .hero-strike-3 {
      animation: hero-strike-in 400ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 840ms;
    }
    .hero-strike-4 {
      animation: hero-strike-in 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 980ms;
    }
  }
</style>
