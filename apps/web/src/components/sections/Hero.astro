---
import TemplateShader from "@components/shaders/template-shader/TemplateShader.astro"
import CtaButton from "@components/CtaButton.astro"
import { BASE_URL } from "@config/site"
---

<section id="hero" class="relative min-h-svh w-full overflow-hidden">
  <div class="absolute inset-0 z-0">
    <TemplateShader />
  </div>

  {/* gradient veil: half-viewport, under the text column */}
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-full bg-linear-to-r from-background via-background/70 to-transparent lg:w-1/2" aria-hidden="true"></div>

  {/* bottom fade: drops dissolve into the page ground instead of a
      hard crop at the hero's edge when scrolling into the next section */}
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40 bg-linear-to-t from-background via-background/70 to-transparent lg:h-56" aria-hidden="true"></div>

  {/* text column rides the same .shell edges as every other section */}
  <div class="shell relative z-20 flex min-h-svh flex-col justify-center pb-16 pt-20 lg:pb-24 lg:pt-24">
    <div class="lg:w-1/2">
      <p class="hero-strike-1 font-mono text-2xs uppercase leading-relaxed tracking-[0.08em] text-muted-foreground sm:tracking-[0.14em] md:tracking-[0.2em]">
        Los Angeles · New Jersey · New York
      </p>
      <h1 class="hero-stamp mt-5 font-secondary text-[clamp(1.5rem,6.8vw,2.5rem)] font-bold tracking-[0.06em] uppercase text-foreground sm:text-5xl md:text-6xl lg:text-7xl">
        Boris Martinez <br/> Tattoo Artist
      </h1>

      <div class="pointer-events-auto flex flex-col items-start gap-6 pt-2 text-left">
        <p class="hero-strike-2 max-w-md text-base text-muted-foreground text-left">I'm a Tattoo Artist who holds every piece to the highest standard, bringing singular designs onto living canvas.</p>
        <div class="hero-strike-3 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <CtaButton href="#booking" title="Book your tattoo session" class="px-8 py-3.5 text-sm">
            Book Your Session
          </CtaButton>
          <CtaButton href={`${BASE_URL}/gallery`} variant="outline" title="See Boris Martinez's tattoo work" class="px-8 py-3.5 text-sm">
            View the register
          </CtaButton>
        </div>
        <p class="hero-strike-4 font-mono text-2xs uppercase leading-relaxed tracking-[0.08em] text-muted-foreground sm:tracking-[0.14em]">
          By appointment only
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* -----------------------------------------------------------------
     The silversmith's stamp — one rehearsed hero entrance.

     The engraved wordmark presses down via clip-path (a hallmark
     stamping metal); the assay tags and CTAs strike in beneath it in
     sequence. Exponential ease-out, ~1.1s total, one-shot.

     Progressive enhancement: content is visible by default. The
     `from` state applies only while the animation is scheduled
     (fill-mode: both). Under prefers-reduced-motion: reduce the
     animations are not declared, so the element stays visible.
     ----------------------------------------------------------------- */
  @keyframes hero-stamp-down {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-strike-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-stamp {
      animation: hero-stamp-down 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 200ms;
    }
    .hero-strike-1 {
      animation: hero-strike-in 400ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-strike-2 {
      animation: hero-strike-in 400ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 550ms;
    }
    .hero-strike-3 {
      animation: hero-strike-in 350ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 700ms;
    }
    .hero-strike-4 {
      animation: hero-strike-in 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 850ms;
    }
  }
</style>
