---
import SectionHeading from '@components/SectionHeading.astro';

const chapters = [
  {
    numeral: '1',
    title: 'Before Appointment',
    items: [
      'Eat well, stay hydrated, and get a full night’s sleep.',
      'Avoid alcohol and recreational drugs for at least 48 hours.',
      'Wear loose, clean clothes allowing easy access to the tattoo area.',
    ],
  },
  {
    numeral: '2',
    title: 'Health conditions & Concerns',
    items: [
      'Tell us about of any existing medical conditions or allergies.',
      'Reschedule if you felt sick or had symptoms in the last 14 days.',
      'Disclose conditions such as diabetes, blood disorders, pregnancy, or blood-thinning medication.',
    ],
  },
  {
    numeral: '3',
    title: 'Aftercare & Recovery',
    items: [
      'Clean and moisturize gently with unscented soap and recommended ointment.',
      'Do not scratch, pick at scabs, or peel flaking skin during healing.',
      'Avoid swimming, soaking, and direct sunlight for at least 2–3 weeks.',
    ],
  },
];
---

<section id="health" class="flex min-h-svh flex-col justify-center border-y border-border bg-raised/50 py-16 md:py-18">
  <div class="shell">
    <div class="reveal">
      <SectionHeading
        tag="Entry IV — The Care"
        title="Safe ink, healthy skin"
        subtitle="The care instructions that accompany every piece — what to know before, during, and after your sitting."
      />
    </div>

    {/* the care chapters: dark register cards, one per chapter */}
    <div class="mt-12 grid gap-px border border-border bg-border lg:grid-cols-3">
      {chapters.map((chapter, i) => (
        <article class="reveal bg-background p-6" style={`--reveal-delay: ${i * 80}ms`}>
          <p class="font-mono text-2xs uppercase tracking-[0.2em] text-tertiary-400">
            {chapter.numeral}
          </p>
          <h3 class="mt-2 font-secondary text-lg tracking-[0.02em] text-foreground">{chapter.title}</h3>
          <ul class="mt-4 space-y-2.5 border-t border-border pt-4">
            {chapter.items.map((item) => (
              <li class="flex items-start gap-2 text-sm leading-snug text-muted-foreground">
                <span class="mt-1.75 size-1 shrink-0 bg-tertiary-400" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    
    <div class="flex justify-center">
      <p class="reveal mt-8 text-center font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground max-w-2xl">
        These recommendations make the tattooing process easier and improve comfort, endurance, and the overall experience.
      </p>
    </div>

  </div>
</section>
