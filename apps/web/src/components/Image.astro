---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: number[];
}

const {
  src,
  alt,
  class: className = 'w-full h-auto object-cover',
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes,
  widths,
} = Astro.props;

const classList = ['border border-border bg-raised object-cover', className];

const isRemote = typeof src === 'string';
---

{isRemote ? (
  <Image
    src={src as string}
    alt={alt}
    width={width ?? 800}
    height={height ?? 1000}
    loading={loading}
    fetchpriority={fetchpriority}
    format="webp"
    quality="high"
    class:list={classList}
  />
) : (
  <Image
    src={src as ImageMetadata}
    alt={alt}
    widths={widths ?? [400, 800, 1200, 1600]}
    sizes={sizes ?? '(min-width: 768px) 48rem, 100vw'}
    loading={loading}
    fetchpriority={fetchpriority}
    format="webp"
    quality="high"
    class:list={classList}
  />
)}
