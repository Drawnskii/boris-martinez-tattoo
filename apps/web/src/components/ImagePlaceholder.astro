---
/* -----------------------------------------------------------------
   ImagePlaceholder — an empty plate in the register, awaiting real
   photography from the studio. Sharp hairline frame, engraved
   diagonal etch, mono label. Swap for a real asset later: replace
   the call with an astro:assets Image or a plain image element.
   Size/shape is driven by the `class` prop (aspect-*, w-*, h-*).
   ----------------------------------------------------------------- */
interface Props {
  label?: string;
  class?: string;
  style?: string;
  /** Icon-only mode for tiny boxes — hides the label text. */
  compact?: boolean;
}

const { label = 'Plate', class: className = '', style, compact = false } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  style={style}
  class:list={[
    'relative flex items-center justify-center overflow-hidden border border-border bg-raised',
    className,
  ]}
>
  {/* etched diagonal — the empty plate's engraving */}
  <svg class="absolute inset-0 size-full text-border" aria-hidden="true" preserveAspectRatio="none">
    <line x1="0" y1="100%" x2="100%" y2="0" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
  <span class="relative flex min-w-0 flex-col items-center gap-2 p-2 text-muted-foreground">
    <svg
      class:list={['shrink-0 opacity-50', compact ? 'size-4' : 'size-7']}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18"></rect>
      <circle cx="9" cy="9" r="2"></circle>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
    </svg>
    {!compact && (
      <span class="max-w-full truncate px-2 font-mono text-2xs uppercase tracking-[0.14em]">{label}</span>
    )}
  </span>
</div>
