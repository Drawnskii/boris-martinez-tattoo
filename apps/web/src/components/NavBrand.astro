---
/* -----------------------------------------------------------------
   NavBrand — wax-seal medallion + Cinzel wordmark. One component,
   three placements (top header, left sidebar, right sidebar).
   ----------------------------------------------------------------- */
import { SITE, BASE_URL } from '@config/site';
import { Icon } from 'astro-icon/components';

interface Props {
  sealSize?: 'sm' | 'md' | '2xl';
  textSize?: string;
  compact?: boolean;
}

const { sealSize = 'md', compact = false } = Astro.props;

const textSizes = {
  sm: 'text-md',
  md: 'text-lg',
  "2xl": 'text-lg sm:text-4xl'
};

/* Split "Boris Martínez Tattoo" into compact lines. */
const words = SITE.name.split(' ');
const compactLines =
  words.length > 1 ? [words.slice(0, -1).join(' '), words[words.length - 1]] : null;
---

<a href={`${BASE_URL}/`} class="group flex min-w-0 items-center gap-3" aria-label={`${SITE.name} — home`} title={`${SITE.name} — home`}>
  <Icon name="thunder-brand-logo-foreground-driping" class={`shrink-0 w-auto ${compact ? 'h-12' : 'h-9 sm:h-12'}`} />
  {compact && compactLines ? (
    <span class={`flex flex-col font-secondary font-semibold uppercase leading-tight tracking-[0.08em] text-foreground ${textSizes[sealSize]}`}>
      {compactLines.map((line) => <span>{line}</span>)}
    </span>
  ) : (
    <span class={`min-w-0 truncate font-secondary ${textSizes[sealSize]} font-semibold tracking-[0.08em] uppercase text-foreground`}>
      {SITE.name}
    </span>
  )}
</a>