# Navbar layout: "header" (default), "left" (left sidebar), "right" (right sidebar)
PUBLIC_NAV_LAYOUT=header

# Canonical site URL (used by astro `site` config in production)
# PUBLIC_ASTRO_SITE=https://boris-martinez-tattoo.com

# Base path when deployed under a subpath (e.g. GitHub Pages)
# PUBLIC_ASTRO_BASE=/

# Provisional configuration for Cloudflare R2
# PUBLIC_R2_URL=

# Provisional frontend static mail provider
# PUBLIC_WEB3FORMS_KEY=